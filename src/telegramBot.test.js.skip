import { jest } from '@jest/globals';
import { http, HttpResponse } from 'msw';
import { setupServer } from 'msw/node';
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

// Helper to load JSON fixtures
const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const loadFixture = (filePath) => {
    const absolutePath = path.resolve(__dirname, '../', filePath);
    return JSON.parse(fs.readFileSync(absolutePath, 'utf-8'));
};

// --- Manage config.js mock manually ---
let currentConfigMock = {
    __esModule: true,
    default: {
        telegramToken: 'TELEGRAMBOT_TEST_INITIAL_TOKEN',
        devChatId: 'TELEGRAMBOT_TEST_INITIAL_DEV_CHAT_ID',
        mongoDbCredentials: 'test-user:test-pass',
        mongoSubdomain: 'test-cluster.mongodb.net',
        mongoURI: 'mongodb+srv://test-user:test-pass@test-cluster.mongodb.net/?retryWrites=true&w=majority',
        branch: 'test-branch',
        inst: 'test-inst',
        host: 'test-host',
        totalInst: '1',
        debugging: false,
        codeVer: 'test-v0.0.0',
        instActiveUntil: '2000-01-01',
        port: 3007,
        timerCheckMinutes: 60,
        timerSendHours: 24,
        pingTargetGeneral: 'http://test.example.com',
        pingTargetAlternative: 'http://test.example.org',
        pingTargetTelegramApiBase: 'http://test.api.telegram.org',
        botLaunchRetryDelay: 1000,
        maxBotLaunchRetries: 1,
    },
};
jest.unstable_mockModule('./config.js', () => currentConfigMock);

// --- MSW Server Setup & Fixtures ---
const getMeSuccessFixture = loadFixture('test/__fixtures__/telegram_api/responses/getMe_success.json');
const baseSendMessageSuccessFixture = loadFixture('test/__fixtures__/telegram_api/responses/sendMessage_success.json');
const mockTextMessageUpdateResultBase = loadFixture('test/__fixtures__/telegram_api/updates/textMessage_command_start.json');

let getUpdatesCalledOnce = false;
let nextTestUpdateId = mockTextMessageUpdateResultBase[0].update_id;

// --- Mock Telegraf (Markup only) ---
jest.unstable_mockModule('telegraf', () => {
    const ActualTelegraf = jest.requireActual('telegraf');
    return {
        __esModule: true,
        Telegraf: ActualTelegraf.Telegraf,
        Markup: {
            inlineKeyboard: jest.fn((buttons) => ({ inline_keyboard: buttons })),
            button: {
                callback: jest.fn((text, data) => ({ text, callback_data: data })),
                url: jest.fn((text, url) => ({ text, url })),
            },
        },
        Composer: ActualTelegraf.Composer,
        session: ActualTelegraf.session,
        Context: ActualTelegraf.Context,
    };
});

// --- Mock Logger ---
const mockLogger = jest.fn();
const mockSetBotInstance = jest.fn();
const mockBootstrapLogger = jest.fn();
jest.unstable_mockModule('./logger.js', () => ({
    __esModule: true,
    logger: mockLogger,
    setBotInstance: mockSetBotInstance,
    bootstrapLogger: mockBootstrapLogger,
}));

// --- Mock other SUT direct dependencies ---
const databaseMock = {
    lastAyaTime: jest.fn(),
    setFavReciter: jest.fn(),
    getFavReciter: jest.fn(),
};
jest.unstable_mockModule('./database.js', () => ({ __esModule: true, ...databaseMock }));

const commandHandlersMock = {
    handleStartCommand: jest.fn(),
    handleHelpCommand: jest.fn(),
    handleSurpriseMeCommand: jest.fn(),
    handleSupportCommand: jest.fn(),
    handleRecitersCommand: jest.fn(),
    handleChannelCommand: jest.fn(),
    handleKhatmaCommand: jest.fn(),
    handleCommandsCommand: jest.fn(),
};
jest.unstable_mockModule('./botHandlers/commandHandlers.js', () => ({ __esModule: true, ...commandHandlersMock }));

jest.unstable_mockModule('./botFeatures/khatmaService.js', () => ({ __esModule: true, khatmaUpdate: jest.fn() }));

// quranService mocks
import rasmifizeActual from 'rasmify.js';
const quranServiceMock = {
    prepareAya: jest.fn(),
    getRecitation: jest.fn(),
    isValidReciter: jest.fn(),
    getRandomReciterIdentifier: jest.fn(),
    nextAya: jest.fn(),
    ayaId2suraAya: jest.fn(),
    suraAya2ayaId: jest.fn(),
    getQuranData: jest.fn(() => ({
        arReciters: [],
        enQuran: [
            { number: 1, name: 'Surat Al-Fatihah', englishName: 'Al-Fatihah', ayahs: [{number: 1, numberInSurah: 1 }]},
            { number: 2, name: 'Surat Al-Baqarah', englishName: 'Al-Baqarah', ayahs: [{number: 2, numberInSurah: 1 }, {number: 255, numberInSurah: 255}]},
            { number: 3, name: 'Surat Aal-E-Imran', englishName: 'Aal-E-Imran', ayahs: [{number: 263, numberInSurah: 1 }]},
        ],
    })),
    checkSource: jest.fn().mockResolvedValue(undefined),
    normalizedSurasArNames: [rasmifizeActual('Al-Fatihah'), rasmifizeActual('Al-Baqarah'), rasmifizeActual('Aal-E-Imran')],
    rasmifize: rasmifizeActual,
};
jest.unstable_mockModule('./quranService.js', () => ({ __esModule: true, ...quranServiceMock }));

const reciterServiceMock = {
    populateRecitersButtons: jest.fn(),
    recitersNavPage: jest.fn(),
};
jest.unstable_mockModule('./botFeatures/reciterService.js', () => ({ __esModule: true, ...reciterServiceMock }));

const utilsMock = {
    randomAyaNumber: jest.fn(),
    numArabicToEnglish: jest.fn((text) => text),
    maskTokenInUrl: jest.fn((url) => url),
    checkConnectivity: jest.fn().mockResolvedValue({ success: true, details: 'Mocked connectivity success' }),
    sendEmergencyNotification: jest.fn().mockResolvedValue(undefined),
};
jest.unstable_mockModule('./utils.js', () => ({ __esModule: true, ...utilsMock }));


// --- SUT variables ---
let bot, launchBot, /* sendAya is now mocked */ surpriseAya, handleText, botUsernameReady;
let telegramBotModule; // To hold the module (which will have some mocks)

// --- Mock specific exports of the SUT (telegramBot.js) ---
const mockSendAya = jest.fn();
jest.unstable_mockModule('./telegramBot.js', async () => { // Make the factory async
    const actualModule = await import('./telegramBot.js'); // Use dynamic import for actual module
    return {
        __esModule: true,
        ...actualModule, // Spread actual implementations
        sendAya: mockSendAya, // Override sendAya with our mock
    };
});

// --- MSW Server & Spies ---
let mswServer;
let botLaunchSpy, botStartSpy, botHelpSpy, botCommandSpy, botOnSpy, botActionSpy, botCatchSpy;
let botTelegramCallApiSpy;


beforeAll(async () => {
    jest.resetModules();
    const globalMockDefault = (await import('./__mocks__/config.mock.js')).default;
    currentConfigMock = { __esModule: true, default: globalMockDefault };

    mswServer = setupServer(
        http.get(`https://api.telegram.org/bot${currentConfigMock.default.telegramToken}/getMe`, () => HttpResponse.json(getMeSuccessFixture)),
        http.post(`https://api.telegram.org/bot${currentConfigMock.default.telegramToken}/getMe`, () => HttpResponse.json(getMeSuccessFixture)),
        http.post(`https://api.telegram.org/bot${currentConfigMock.default.telegramToken}/sendMessage`, async ({ request }) => {
            const requestBody = await request.json();
            const dynamicResponse = JSON.parse(JSON.stringify(baseSendMessageSuccessFixture));
            dynamicResponse.result.from = getMeSuccessFixture.result;
            dynamicResponse.result.chat.id = requestBody.chat_id;
            dynamicResponse.result.text = requestBody.text;
            dynamicResponse.result.date = Math.floor(Date.now() / 1000);
            return HttpResponse.json(dynamicResponse);
        }),
        http.post(`https://api.telegram.org/bot${currentConfigMock.default.telegramToken}/getUpdates`, async () => {
            if (!getUpdatesCalledOnce) {
                getUpdatesCalledOnce = true;
                const updateToSend = JSON.parse(JSON.stringify(mockTextMessageUpdateResultBase));
                updateToSend[0].update_id = nextTestUpdateId++;
                return HttpResponse.json({ ok: true, result: updateToSend });
            }
            console.debug('MSW /getUpdates: Polling limit reached for test, returning error to stop.');
            return HttpResponse.json({ ok: false, error_code: 500, description: 'Test-induced stop polling' }, { status: 500 });
        }),
        http.post(`https://api.telegram.org/bot${currentConfigMock.default.telegramToken}/setMyCommands`, () => HttpResponse.json({ ok: true, result: true })),
        http.post(`https://api.telegram.org/bot${currentConfigMock.default.telegramToken}/deleteWebhook`, () => HttpResponse.json({ ok: true, result: true })),
        http.post(`https://api.telegram.org/bot${currentConfigMock.default.telegramToken}/deleteMessage`, () => HttpResponse.json({ ok: true, result: true })),
        http.post(`https://api.telegram.org/bot${currentConfigMock.default.telegramToken}/editMessageReplyMarkup`, () => HttpResponse.json({ ok: true, result: true })),
        http.post(`https://api.telegram.org/bot${currentConfigMock.default.telegramToken}/sendAudio`, () => HttpResponse.json({ ok: true, result: { message_id: 1000, chat: {id: 123}}})),
        http.post(`https://api.telegram.org/bot${currentConfigMock.default.telegramToken}/answerCallbackQuery`, () => HttpResponse.json({ ok: true, result: true }))
    );
    mswServer.listen({ onUnhandledRequest: 'warn' });

    telegramBotModule = await import('./telegramBot.js'); // This will import the mocked module
    bot = telegramBotModule.bot;
    launchBot = telegramBotModule.launchBot;
    // sendAya is now directly the mockSendAya via the module mock, no need to assign it from telegramBotModule.sendAya
    surpriseAya = telegramBotModule.surpriseAya; // Actual surpriseAya
    handleText = telegramBotModule.handleText;   // Actual handleText
    botUsernameReady = telegramBotModule.botUsernameReady;

    botLaunchSpy = jest.spyOn(bot, 'launch');
    botStartSpy = jest.spyOn(bot, 'start');
    botHelpSpy = jest.spyOn(bot, 'help');
    botCommandSpy = jest.spyOn(bot, 'command');
    botOnSpy = jest.spyOn(bot, 'on');
    botActionSpy = jest.spyOn(bot, 'action');
    botCatchSpy = jest.spyOn(bot, 'catch');

    await botUsernameReady;
    await new Promise(resolve => setTimeout(resolve, 0));

    botTelegramCallApiSpy = jest.spyOn(bot.telegram, 'callApi');
    // Default spy behavior (jest.spyOn without a subsequent .mockImplementation())
    // is to call the original method while still tracking calls. This is what we want for MSW.

    expect(bot.options.username).toBe(getMeSuccessFixture.result.username);
    expect(mockSetBotInstance).toHaveBeenCalledWith(bot);
});

afterEach(() => {
    mswServer.resetHandlers();
    mockLogger.mockClear();
    mockSetBotInstance.mockClear();
    mockBootstrapLogger.mockClear();

    botStartSpy?.mockClear();
    botHelpSpy?.mockClear();
    botCommandSpy?.mockClear();
    botOnSpy?.mockClear();
    botActionSpy?.mockClear();
    botLaunchSpy?.mockClear();
    botCatchSpy?.mockClear();
    botTelegramCallApiSpy?.mockClear();
    mockSendAya.mockClear(); // Clear the mocked sendAya

    getUpdatesCalledOnce = false;
    Object.values(databaseMock).forEach(mockFn => mockFn.mockClear());
    Object.values(commandHandlersMock).forEach(mockFn => mockFn.mockClear());

    Object.keys(quranServiceMock).forEach(key => {
        if (quranServiceMock[key] && typeof quranServiceMock[key].mockClear === 'function') {
            quranServiceMock[key].mockClear();
        }
    });
    quranServiceMock.getQuranData.mockReturnValue({
        arReciters: [],
        enQuran: [
            { number: 1, name: 'Surat Al-Fatihah', englishName: 'Al-Fatihah', ayahs: [{number: 1, numberInSurah: 1 }]},
            { number: 2, name: 'Surat Al-Baqarah', englishName: 'Al-Baqarah', ayahs: [{number: 2, numberInSurah: 1 }, {number: 255, numberInSurah: 255}]},
            { number: 3, name: 'Surat Aal-E-Imran', englishName: 'Aal-E-Imran', ayahs: [{number: 263, numberInSurah: 1 }]},
        ],
    });
    quranServiceMock.checkSource.mockResolvedValue(undefined);
    quranServiceMock.rasmifize = rasmifizeActual;
    quranServiceMock.normalizedSurasArNames = [rasmifizeActual('Al-Fatihah'), rasmifizeActual('Al-Baqarah'), rasmifizeActual('Aal-E-Imran')];

    Object.values(reciterServiceMock).forEach(mockFn => mockFn.mockClear());
    Object.values(utilsMock).filter(m => typeof m === 'function').forEach(mockFn => mockFn.mockClear());
    utilsMock.checkConnectivity.mockResolvedValue({ success: true, details: 'Mocked connectivity success' });
    utilsMock.sendEmergencyNotification.mockResolvedValue(undefined);
    utilsMock.numArabicToEnglish.mockImplementation(text => text);
    utilsMock.maskTokenInUrl.mockImplementation(url => url);
    utilsMock.randomAyaNumber.mockReturnValue(123);

    quranServiceMock.prepareAya.mockReturnValue({ arText: 'Mocked Arabic Text', enText: 'Mocked English Text' });
    quranServiceMock.getRecitation.mockResolvedValue('mock.audio.url');
    quranServiceMock.isValidReciter.mockReturnValue(true);
    quranServiceMock.ayaId2suraAya.mockReturnValue({ sura: 1, aya: 1 });
    quranServiceMock.suraAya2ayaId.mockReturnValue(1);
});

afterAll(() => mswServer?.close());

describe('Telegram Bot - Initialization and Structure', () => {
    it('should have initialized correctly (core checks in beforeAll)', () => {
        expect(typeof bot.handleUpdate).toBe('function');
        expect(typeof bot.secretPathComponent).toBe('function');
        expect(true).toBe(true);
    });
    it('launchBot should be a function', () => expect(typeof launchBot).toBe('function'));
    // it('sendAya should be a function', () => expect(typeof sendAya).toBe('function')); // sendAya is now a mock
    it('mockSendAya should be a mock function', () => expect(jest.isMockFunction(mockSendAya)).toBe(true));
    it('surpriseAya should be a function', () => expect(typeof surpriseAya).toBe('function'));
    it('handleText should be a function', () => expect(typeof handleText).toBe('function'));
});

describe('launchBot', () => {
    it('should launch the bot and send startup message if devChatId is configured', async () => {
        await launchBot();
        expect(botLaunchSpy).toHaveBeenCalledTimes(1);
        expect(botTelegramCallApiSpy).toHaveBeenCalledWith('sendMessage', expect.objectContaining({
            chat_id: currentConfigMock.default.devChatId,
            text: expect.stringContaining(`DailyAyaTelegram ${currentConfigMock.default.branch} instance`),
        }));
        expect(quranServiceMock.checkSource).toHaveBeenCalled();
    });

    it('should not send startup message if devChatId is not configured', async () => {
        const originalDevChatId = currentConfigMock.default.devChatId;
        currentConfigMock.default.devChatId = null;
        await launchBot();
        const sendMessageToDevChatCall = botTelegramCallApiSpy.mock.calls.find(call =>
            call[0] === 'sendMessage' && call[1].chat_id === originalDevChatId
        );
        expect(sendMessageToDevChatCall).toBeUndefined();
        currentConfigMock.default.devChatId = originalDevChatId;
    });

    it('should log "Cannot send" if devChatId is set but bot username is not (simulated by getMe failure)', async () => {
        mswServer.use(http.post(`https://api.telegram.org/bot${currentConfigMock.default.telegramToken}/getMe`, () => {
            return HttpResponse.json({ ok: false, error_code: 401, description: 'Unauthorized' }, { status: 401 });
        }, { once: true }));

        await jest.resetModules();
        const tempTelegramBotModule = await import('./telegramBot.js');
        await tempTelegramBotModule.botUsernameReady;

        if (tempTelegramBotModule.bot) tempTelegramBotModule.bot.options.username = null;

        await tempTelegramBotModule.launchBot();
        expect(mockBootstrapLogger).toHaveBeenCalledWith(
            'launchBot: Cannot send startup state message to dev group - bot username not available or devChatId not set.'
        );
    });

    it('should handle bot.launch() failure', async () => {
        botLaunchSpy.mockImplementationOnce(() => { throw new Error('Launch Failed'); });
        await expect(launchBot()).rejects.toThrow('Launch Failed');
    });

    it('should not call checkSource if debugging is true', async () => {
        currentConfigMock.default.debugging = true;
        await launchBot();
        expect(quranServiceMock.checkSource).not.toHaveBeenCalled();
        currentConfigMock.default.debugging = false;
    });

    it('should call checkSource with a functional sendMessage callback', async () => {
        currentConfigMock.default.debugging = false;
        await launchBot();
        expect(quranServiceMock.checkSource).toHaveBeenCalledWith(expect.any(Function));
    });
});

describe('sendAya', () => {
    const chatId = 'chatSendAya1';
    const lang = 'ar';
    const trigger = 'testTrigger';

    beforeEach(() => {
        databaseMock.getFavReciter.mockResolvedValue({ success: true, data: 'fav.reciter' });
        quranServiceMock.isValidReciter.mockImplementation((reciterId) => {
            return reciterId === 'fav.reciter' || reciterId === 'reciter.id' || reciterId === 'another.reciter.id';
        });
    });

    it('should send text and recitation when ayaId is provided and withRecitation is true', async () => {
        const ayaId = 262;
        await sendAya(chatId, ayaId, 'reciter.id', lang, trigger, true);

        const sendMessageCall = botTelegramCallApiSpy.mock.calls.find(call => call[0] === 'sendMessage' && call[1].chat_id === chatId);
        expect(sendMessageCall).toBeDefined();
        expect(sendMessageCall[1].text).toContain('Mock Arabic Text');
        expect(sendMessageCall[1].parse_mode).toBe('HTML');

        const sendAudioCall = botTelegramCallApiSpy.mock.calls.find(call => call[0] === 'sendAudio' && call[1].chat_id === chatId);
        expect(sendAudioCall).toBeDefined();
        expect(sendAudioCall[1].audio).toBe('mock.audio.url');
        expect(sendAudioCall[1].caption).toContain(`@${bot.options.username} ➔ 1:1`);

        expect(databaseMock.lastAyaTime).toHaveBeenCalledWith(chatId, 'success', expect.any(String), 'private', lang, trigger);
    });

    it('should send random Aya with text and recitation when ayaId is null and withRecitation is true', async () => {
        const randomAyaId = 123;
        utilsMock.randomAyaNumber.mockReturnValue(randomAyaId);

        await sendAya(chatId, null, null, lang, trigger, true);

        expect(utilsMock.randomAyaNumber).toHaveBeenCalledTimes(1);

        const sendMessageCall = botTelegramCallApiSpy.mock.calls.find(call => call[0] === 'sendMessage' && call[1].chat_id === chatId);
        expect(sendMessageCall).toBeDefined();
        expect(sendMessageCall[1].text).toContain('Mock Arabic Text');

        expect(quranServiceMock.prepareAya).toHaveBeenCalledWith(randomAyaId, bot.options.username);
        expect(quranServiceMock.getRecitation).toHaveBeenCalledWith(randomAyaId, 'fav.reciter');

        const sendAudioCall = botTelegramCallApiSpy.mock.calls.find(call => call[0] === 'sendAudio' && call[1].chat_id === chatId);
        expect(sendAudioCall).toBeDefined();
        expect(sendAudioCall[1].audio).toBe('mock.audio.url');

        expect(databaseMock.lastAyaTime).toHaveBeenCalled();
    });

    it('should use specified reciter when provided, for recitation', async () => {
        const ayaId = 456;
        const specificReciter = 'another.reciter.id';

        await sendAya(chatId, ayaId, specificReciter, lang, trigger, true);

        expect(quranServiceMock.getRecitation).toHaveBeenCalledWith(ayaId, specificReciter);
        const sendAudioCall = botTelegramCallApiSpy.mock.calls.find(call => call[0] === 'sendAudio');
        expect(sendAudioCall).toBeDefined();
    });

    it('should call sendSorry via helper if prepareAyaFn returns an error', async () => {
        quranServiceMock.prepareAya.mockReturnValue({ arText: 'Error: Test Aya Prep Error', enText: 'Error details' });

        await sendAya(chatId, 789, null, lang, trigger, false);

        const sendMessageCall = botTelegramCallApiSpy.mock.calls.find(call => call[0] === 'sendMessage' && call[1].chat_id === chatId);
        expect(sendMessageCall).toBeDefined();
        expect(sendMessageCall[1].text).toContain("Sorry.. There's an issue in Aya texts");

        expect(databaseMock.lastAyaTime).not.toHaveBeenCalled();
    });

    it('should call lastAyaTime with "blocked" if sendAudio fails with a block error', async () => {
        const ayaId = 101;
        const blockError = new Error('Blocked by user');
        blockError.response = { description: 'Forbidden: bot was blocked by the user' };

        const originalCallApiImpl = botTelegramCallApiSpy.getMockImplementation();
        botTelegramCallApiSpy.mockImplementation(async (method, payload) => {
            if (method === 'sendAudio') throw blockError;
            if (originalCallApiImpl && typeof originalCallApiImpl === 'function') { // Check if it's a function
                 return originalCallApiImpl.apply(bot.telegram, [method, payload]);
            }
            return Promise.resolve({ok: true, result: true});
        });

        await sendAya(chatId, ayaId, 'reciter.id', lang, trigger, true);

        const sendMessageCall = botTelegramCallApiSpy.mock.calls.find(call => call[0] === 'sendMessage');
        expect(sendMessageCall).toBeDefined()

        const sendAudioCall = botTelegramCallApiSpy.mock.calls.find(call => call[0] === 'sendAudio');
        expect(sendAudioCall).toBeDefined(); // This will now fail if sendAudio throws

        expect(databaseMock.lastAyaTime).toHaveBeenCalledWith(chatId, 'success', expect.any(String), 'private', lang, trigger);
        expect(databaseMock.lastAyaTime).toHaveBeenCalledWith(chatId, 'blocked');

        if (originalCallApiImpl) botTelegramCallApiSpy.mockImplementation(originalCallApiImpl);
    });
});

describe('surpriseAya', () => {
    it('should call sendAya with null ayaId, null reciter, and withRecitation=false', async () => {
        const mockCtx = {
            chat: { id: 'chatSurprise1', type: 'private' },
            from: { id: 'userSurprise1', language_code: 'en' },
        };
        // sendAya is now mocked at the module level by mockSendAya
        // surpriseAya (the actual function) should call the mocked sendAya

        await surpriseAya(mockCtx); // Call the actual surpriseAya

        expect(mockSendAya).toHaveBeenCalledWith( // Check if the mock was called
            mockCtx.chat.id, null, null, mockCtx.from.language_code, 'surprise', false
        );
    });
});


describe('MSW - Incoming /getUpdates', () => {
    it('should process an incoming /start command from MSW /getUpdates', async () => {
        commandHandlersMock.handleStartCommand.mockClear();
        await launchBot();
        await new Promise((resolve) => setTimeout(resolve, 300));
        expect(commandHandlersMock.handleStartCommand).toHaveBeenCalledTimes(1);
    }, 1500);
});

describe('handleText (direct test of exported function)', () => {
    let mockCtx;
    let originalSuraAya2AyaId;
    let originalAyaId2SuraAya;

    beforeAll(async () => {
        const quranServiceActual = await import('./quranService.js');
        originalSuraAya2AyaId = quranServiceActual.suraAya2ayaId;
        originalAyaId2SuraAya = quranServiceActual.ayaId2suraAya;
    });

    beforeEach(() => {
        mockCtx = {
            chat: { id: 'chatHandleText1', type: 'private' },
            from: { id: 'userHandleText1', language_code: 'ar' },
            message: { text: '' },
        };
        quranServiceMock.suraAya2ayaId.mockImplementation(originalSuraAya2AyaId);
        quranServiceMock.ayaId2suraAya.mockImplementation(originalAyaId2SuraAya);
        bot.options.username = getMeSuccessFixture.result.username;
        botTelegramCallApiSpy.mockClear().mockResolvedValue({ ok: true, result: { chat: { id: mockCtx.chat.id }, message_id: 1234 }});
    });

    it('should correctly parse "سورة البقرة" and call sendAya for Sura 2, Aya 1', async () => {
        mockCtx.message.text = 'سورة البقرة';
        const expectedAyaId = 2;
        await handleText(mockCtx);
        expect(quranServiceMock.prepareAya).toHaveBeenCalledWith(expectedAyaId, bot.options.username);
    });

    it('should correctly parse "البقره ايه ١" (Al-Baqarah, Aya 1) and call sendAya', async () => {
        mockCtx.message.text = 'البقره ايه ١';
        const expectedAyaId = 2;
        await handleText(mockCtx);
        expect(quranServiceMock.prepareAya).toHaveBeenCalledWith(expectedAyaId, bot.options.username);
    });

    it('should correctly parse "ال عمران" and call sendAya for Sura 3, Aya 1', async () => {
        mockCtx.message.text = 'ال عمران';
        const expectedAyaId = 263;
        await handleText(mockCtx);
        expect(quranServiceMock.prepareAya).toHaveBeenCalledWith(expectedAyaId, bot.options.username);
    });

    it('should correctly parse "ال عمران 5" and call sendAya for Sura 3, Aya 5', async () => {
        mockCtx.message.text = 'ال عمران 5';
        const expectedAyaId = 267;
        await handleText(mockCtx);
        expect(quranServiceMock.prepareAya).toHaveBeenCalledWith(expectedAyaId, bot.options.username);
    });

    it('should correctly parse "الفاتحة" and call sendAya for Sura 1, Aya 1', async () => {
        mockCtx.message.text = 'الفاتحة';
        const expectedAyaId = 1;
        await handleText(mockCtx);
        expect(quranServiceMock.prepareAya).toHaveBeenCalledWith(expectedAyaId, bot.options.username);
    });

    it('should handle numeric input "2 255" (Ayat al-Kursi)', async () => {
        mockCtx.message.text = '2 255';
        const expectedAyaId = 262;
        await handleText(mockCtx);
        expect(quranServiceMock.prepareAya).toHaveBeenCalledWith(expectedAyaId, bot.options.username);
    });

    it('should handle "آية الكرسي" keyword', async () => {
        mockCtx.message.text = 'آية الكرسي';
        const expectedAyaId = 262;
        await handleText(mockCtx);
        expect(quranServiceMock.prepareAya).toHaveBeenCalledWith(expectedAyaId, bot.options.username);
    });

    it('should call sendUnrecognizedMessage for completely unparseable text', async () => {
        mockCtx.message.text = 'some random gibberish';

        const originalCallApiImpl = botTelegramCallApiSpy.getMockImplementation();
        botTelegramCallApiSpy.mockImplementation(async (method, payload) => {
            if (method === 'getChatMember') return { ok: true, result: { status: 'administrator' }}; // Ensure getChatMember returns properly for admin check
            if (originalCallApiImpl) return originalCallApiImpl.apply(bot.telegram, [method, payload]);
            return Promise.resolve({ok: true, result: {message_id: 1}});
        });

        await handleText(mockCtx);

        expect(botTelegramCallApiSpy).toHaveBeenCalledWith('sendMessage', expect.objectContaining({
            chat_id: mockCtx.chat.id,
            text: expect.stringContaining("Sorry, we couldn't recognize a Sura name")
        }));
        if(originalCallApiImpl) botTelegramCallApiSpy.mockImplementation(originalCallApiImpl);
    });
});

