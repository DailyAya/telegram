describe('Action Handler Integration for "recite" button', () => {
    it('placeholder', () => expect(true).toBe(true));

    it('should process a valid "recite" callback query via MSW and attempt to send audio', async () => {
        const ayaIdToRecite = 777;
        const reciterId = 'ar.alafasy';
        const chatId = 123456789;
        const messageId = 555;
        const callbackQueryId = 'cbq123';
        const userId = 987654;

        const reciteCallbackQuery = {
            update_id: 200000000,
            callback_query: {
                id: callbackQueryId,
                from: { id: userId, is_bot: false, first_name: 'TestReciteUser', username: 'testreciteuser', language_code: 'en' },
                message: { message_id: messageId, from: { ...getMeSuccessFixture.result }, chat: { id: chatId, type: 'private', first_name: 'TestReciteUser', username: 'testreciteuser' }, date: Math.floor(Date.now() / 1000), text: 'Some message with a button' },
                chat_instance: 'chatinst123', data: JSON.stringify({ recite: ayaIdToRecite, r: reciterId }),
            },
        };

        mswServer.use( http.post(`https://api.telegram.org/bot${currentConfigMock.default.telegramToken}/getUpdates`, async () => {
            if (!getUpdatesCalledOnce) { getUpdatesCalledOnce = true; return HttpResponse.json({ ok: true, result: [reciteCallbackQuery] }); }
            return HttpResponse.json( { ok: false, error_code: 500, description: 'Test-induced stop polling' }, { status: 500 } );
        }, { once: true } ) );

        quranServiceMock.ayaId2suraAya.mockReturnValue({ sura: 11, aya: 11 });
        quranServiceMock.isValidReciter.mockReturnValue(true);
        quranServiceMock.getRecitation.mockResolvedValue('http://mock.audio.url/recite777.mp3');
        databaseMock.getFavReciter.mockResolvedValue({ success: true, data: reciterId });

        const originalCallApiImpl = botTelegramCallApiSpy.getMockImplementation();
        botTelegramCallApiSpy.mockImplementation(async (method, payload) => {
            if (method === 'getChatMember' && payload.user_id === userId) return { ok: true, result: { status: 'administrator' }};
            if (originalCallApiImpl) return originalCallApiImpl.apply(bot.telegram, [method, payload]);
            return Promise.resolve({ok: true, result: true});
        });

        await launchBot();
        await new Promise((resolve) => setTimeout(resolve, 300));

        expect(botTelegramCallApiSpy).toHaveBeenCalledWith('answerCallbackQuery', expect.objectContaining({ callback_query_id: callbackQueryId }));

        const sendAudioCall = botTelegramCallApiSpy.mock.calls.find(call => call[0] === 'sendAudio');
        expect(sendAudioCall).toBeDefined();
        if (sendAudioCall) {
            const sendAudioPayload = sendAudioCall[1];
            expect(sendAudioPayload.chat_id).toBe(chatId);
            expect(sendAudioPayload.audio).toBe('http://mock.audio.url/recite777.mp3');
            expect(sendAudioPayload.caption).toContain(`@${bot.options.username} ➔ 11:11`);
        }

        if(originalCallApiImpl) botTelegramCallApiSpy.mockImplementation(originalCallApiImpl);
        getUpdatesCalledOnce = false;
    }, 1500);
});
